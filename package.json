{
  "name": "live-interpreter",
  "version": "1.0.0",
  "description": "桌面同声传译：系统声音转字幕，自己说的话转成外语语音",
  "main": "./out/main/index.js",
  "author": "huanghe",
  "license": "MIT",
  "homepage": "https://github.com/huang-hee/live-interpreter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huang-hee/live-interpreter.git"
  },
  "bugs": {
    "url": "https://github.com/huang-hee/live-interpreter/issues"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "pack:mac": "electron-vite build && electron-builder --mac --dir",
    "build:linux": "electron-vite build && electron-builder --linux",
    "test:unit": "esbuild tests/unit.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=tests/.output/unit.test.cjs --log-level=warning && node --test tests/.output/unit.test.cjs",
    "test:e2e": "electron-vite build && esbuild tests/e2e/app.e2e.ts --bundle --platform=node --format=esm --packages=external --outfile=tests/.output/app.e2e.mjs --log-level=warning && node tests/.output/app.e2e.mjs",
    "test:live": "esbuild tests/live.ts --bundle --platform=node --format=cjs --packages=external --outfile=tests/.output/live.cjs --log-level=warning && node tests/.output/live.cjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "playwright-core": "^1.63.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
